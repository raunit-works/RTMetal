{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "edit": "ask",
        "bash": {
            "*": "ask",
            "git push*": "deny",
            "git reset --hard*": "deny",
            "git clean*": "deny"
        },
        "external_directory": "ask",
        "read": {
            "*": "allow",
            "*.env": "deny",
            "*.env.*": "deny",
            "*.env.example": "allow"
        }
    }
}